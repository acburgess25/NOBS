NOBS_ENVIRONMENT=development
NOBS_DATABASE_URL=sqlite:///./nobs.db
NOBS_VERSION=0.1.0
NOBS_OLLAMA_BASE_URL=http://127.0.0.1:11434
NOBS_OLLAMA_MODEL=qwen3:8b
NOBS_CODING_MODEL=qwen2.5-coder:14b
NOBS_OLLAMA_TIMEOUT_SECONDS=45
NOBS_AGENT_BACKGROUND_TIMEOUT_SECONDS=120
NOBS_DEVICE_TOKEN=
NOBS_AGENT_DATABASE_PATH=data/nobs-agent.db
NOBS_AGENT_WORKSPACE_PATH=data/agent-workspace
NOBS_AGENT_PROJECT_PATH=.
NOBS_AGENT_MAX_STEPS=4
NOBS_DASHBOARD_NAME=Tank
NOBS_TIMEZONE=UTC
NOBS_OVERNIGHT_QUEUE_ENABLED=true
NOBS_OVERNIGHT_WINDOW_START=23:00
NOBS_OVERNIGHT_WINDOW_END=06:00
NOBS_OVERNIGHT_IDLE_CPU_PERCENT=40.0
# Dream Team Sandbox (local Ollama only — no cloud/external APIs in refinement loop)
NOBS_DREAM_TEAM_ENABLED=true
# NOBS_DREAM_TEAM_MODEL=qwen3:8b
NOBS_DREAM_TEAM_MAX_AGENTS=3
NOBS_DREAM_TEAM_MAX_ITERATIONS=2
NOBS_DREAM_TEAM_SANDBOX_MAX_STEPS=2
NOBS_DREAM_TEAM_SCORE_THRESHOLD=0.65
NOBS_DREAM_TEAM_SANDBOX_PATH=data/dream-team-sandbox
NOBS_DREAM_TEAM_ACTIVE_PATH=data/dream-team/active
# Live workplace dashboard (animated floor + filtered browser sandbox)
NOBS_WORKPLACE_ENABLED=true
NOBS_WORKPLACE_BROWSER_ALLOWED_DOMAINS=wikipedia.org,www.wikipedia.org,en.wikipedia.org,docs.python.org,developer.mozilla.org
# Background Tank optimizer (local Ollama work when idle)
NOBS_OPTIMIZER_ENABLED=true
NOBS_OPTIMIZER_INTENSITY=normal
NOBS_OPTIMIZER_MIN_IDLE_SECONDS=90
NOBS_OPTIMIZER_HEAVY_INTERVAL_MINUTES=20
NOBS_OPTIMIZER_LIGHT_INTERVAL_SECONDS=45
NOBS_OPTIMIZER_MAX_CONCURRENT=1
NOBS_OPTIMIZER_IDLE_CPU_PERCENT=50.0
NOBS_OPTIMIZER_DREAM_TEAM_BATCH_SIZE=3
