NOBS_ENVIRONMENT=development
NOBS_DATABASE_URL=sqlite:///./nobs.db
NOBS_VERSION=0.1.0
NOBS_OLLAMA_BASE_URL=http://127.0.0.1:11434
NOBS_OLLAMA_MODEL=qwen3:8b
NOBS_CODING_MODEL=qwen2.5-coder:14b
NOBS_OLLAMA_TIMEOUT_SECONDS=45
NOBS_DEVICE_TOKEN=
NOBS_AGENT_DATABASE_PATH=data/nobs-agent.db
NOBS_AGENT_WORKSPACE_PATH=data/agent-workspace
NOBS_AGENT_PROJECT_PATH=.
NOBS_AGENT_MAX_STEPS=4
NOBS_DASHBOARD_NAME=Tank
NOBS_TIMEZONE=UTC
NOBS_OVERNIGHT_QUEUE_ENABLED=true
NOBS_OVERNIGHT_WINDOW_START=23:00
NOBS_OVERNIGHT_WINDOW_END=06:00
NOBS_OVERNIGHT_IDLE_CPU_PERCENT=40.0
