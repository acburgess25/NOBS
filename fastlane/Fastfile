default_platform(:ios)

platform :ios do
  desc "Revoke Apple Development certificates (CI keychain prep)"
  lane :revoke_development_certs do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_API_KEY_ID"),
      issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_API_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    certs = Spaceship::ConnectAPI::Certificate.all(
      filter: {
        certificateType: Spaceship::ConnectAPI::Certificate::CertificateType::DEVELOPMENT
      }
    )

    if certs.empty?
      UI.message("No Apple Development certificates to revoke.")
      next
    end

    certs.each do |cert|
      name = cert.display_name || cert.name || cert.id
      UI.message("Revoking development certificate #{cert.id} (#{name})")
      cert.delete!
    end

    UI.success("Revoked #{certs.length} development certificate(s).")
  end
end
